          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ratios de 1:1 a 21:1. WCAG exige 4,5:1 para texto normal y 3:1 para texto grande e interfaz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ratios de 1:1 à 21:1. Les WCAG exigent 4,5:1 pour le texte normal et 3:1 pour le texte de grande taille et l'interface."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "比率は1:1から21:1です。WCAGでは、標準テキストで4.5:1、大きいテキストとUIで3:1が求められます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
