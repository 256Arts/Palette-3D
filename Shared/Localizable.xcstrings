    "Copy a color value such as #FF8800, rgb(255 136 0), or oklch(0.7 0.2 60) and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kopiere einen Farbwert wie #FF8800, rgb(255 136 0) oder oklch(0.7 0.2 60) und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Copia un valor de color como #FF8800, rgb(255 136 0) u oklch(0.7 0.2 60) y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Copiez une valeur de couleur telle que #FF8800, rgb(255 136 0) ou oklch(0.7 0.2 60), puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "#FF8800、rgb(255 136 0)、oklch(0.7 0.2 60)などのカラー値をコピーしてから、もう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "请拷贝一个颜色值，如 #FF8800、rgb(255 136 0) 或 oklch(0.7 0.2 60)，然后重试。"
          }
        }
      }
    },
    "Copy CSS Gradient" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
