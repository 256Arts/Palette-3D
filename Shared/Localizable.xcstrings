    "CIEDE2000 across all %lld color pairs. ΔE below ~2 is barely perceptible; above ~10 is distinct." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "CIEDE2000 über alle %lld Farbpaare. ΔE unter ~2 ist kaum wahrnehmbar; über ~10 ist deutlich unterschiedlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "CIEDE2000 en las %lld parejas de colores. Un ΔE inferior a ~2 es apenas perceptible; superior a ~10 es claramente distinto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "CIEDE2000 sur les %lld paires de couleurs. Un ΔE inférieur à ~2 est à peine perceptible ; supérieur à ~10, il est net."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "すべての%lld組のカラーペアのCIEDE2000。ΔEが約2未満だとほとんど知覚できず、約10を超えると明確に異なります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "所有 %lld 个颜色对的 CIEDE2000。ΔE 低于约 2 几乎无法察觉；高于约 10 则明显不同。"
          }
        }
      }
    },
